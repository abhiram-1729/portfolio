  vendorItemMappings     VendorItemMapping[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  purchaseInvoices       PurchaseInvoice[]
  vendorLedger           VendorLedger[]
  vendorPayments         VendorPayment[]
  procurementStockLedger ProcurementStockLedger[]
  activityLogs           ActivityLog[]
  safeTransactions       SafeTransaction[]

  @@index([tenantId])
}

model SafeTransaction {
  id              String   @id @default(cuid())
  tenantId        String   @default("VK001")
  storeId         String
  date            String   // YYYY-MM-DD
  amount          Float
  type            String   // "DEPOSIT" (Available -> Safe), "WITHDRAW" (Safe -> Available)
  denominations   Json?
  description     String?
  userId          String
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  store           Store    @relation(fields: [storeId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([storeId, date])
}

model StockAudit {
  id        String           @id @default(cuid())
  tenantId  String           @default("VK001")
  storeId   String?
  vehicleId String
  userId    String           
  createdAt DateTime         @default(now())
  remark    String?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  store     Store?           @relation(fields: [storeId], references: [id])
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  items     StockAuditItem[]

  @@index([tenantId])
  @@index([storeId])
  @@index([vehicleId])
  @@index([userId])
}

model StockAuditItem {
  id           String     @id @default(cuid())
  auditId      String
  productId    String
  oldQuantity  Int        
  newQuantity  Int        
  tenantId     String     @default("VK001")
  
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  audit        StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
  @@index([tenantId])
}

// ─── PROCUREMENT, INVENTORY & ACCOUNTS PAYABLE ─────────────

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum POStatus {
  CREATED
  APPROVED
  ORDERED
  DELIVERED
  CLOSED
  CANCELLED
}

enum GRNStatus {
  PARTIAL
  COMPLETE
}

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIAL_PAID
}

enum VendorPaymentMode {
  CASH
  BANK
  UPI
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
}

enum VendorLedgerType {
  PURCHASE
  PAYMENT
  OPENING_BALANCE
}

// ─── VENDOR ─────────────────────────────────────

model Vendor {
  id            String       @id @default(cuid())
  displayId     String?      @unique
  tenantId      String       @default("VK001")
  storeId       String?
  vendorName    String
  mobile        String
  email         String?
  address       String?
  gstNumber     String?
  contactPerson String?
  creditDays    Int          @default(30)
  openingBalance Float       @default(0)
  currentBalance Float       @default(0)
  status        VendorStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  store         Store?       @relation(fields: [storeId], references: [id])
  itemMappings  VendorItemMapping[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  ledgerEntries VendorLedger[]
  payments      VendorPayment[]

  @@unique([tenantId, mobile])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
}

// ─── VENDOR-ITEM MAPPING ─────────────────────────────────────

model VendorItemMapping {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  storeId   String?
  vendorId  String
  productId String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([vendorId, productId])
  @@index([tenantId])
  @@index([storeId])
  @@index([vendorId])
  @@index([productId])
}

// ─── PURCHASE ORDER ─────────────────────────────────────

model PurchaseOrder {
  id                String    @id @default(cuid())
  displayId         String?   @unique
  tenantId          String    @default("VK001")
  storeId           String?
  poNumber          Int       @unique @default(autoincrement())
  vendorId          String
  poDate            DateTime  @default(now())
  expectedDelivery  DateTime?
  remarks           String?
  status            POStatus  @default(CREATED)
  totalAmount       Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  store             Store?    @relation(fields: [storeId], references: [id])
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]
  purchaseInvoices  PurchaseInvoice[]

  @@index([tenantId])
  @@index([storeId])
  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  tenantId    String        @default("VK001")
  poId        String
  productId   String
  quantity    Int
  rate        Float
  total       Float         @default(0)
  receivedQty Int           @default(0)

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([poId])
  @@index([productId])
}

// ─── GOODS RECEIPT NOTE (GRN) ─────────────────────────────────────

model GoodsReceipt {
  id          String    @id @default(cuid())
  displayId   String?   @unique
  tenantId    String    @default("VK001")
  storeId     String?
  poId        String
  grnDate     DateTime  @default(now())
  status      GRNStatus @default(PARTIAL)
  remarks     String?
  createdAt   DateTime  @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  store       Store?        @relation(fields: [storeId], references: [id])
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  items       GoodsReceiptItem[]

  @@index([tenantId])
  @@index([storeId])
  @@index([poId])
}

model GoodsReceiptItem {
  id            String       @id @default(cuid())
  tenantId      String       @default("VK001")
  grnId         String
  productId     String
  orderedQty    Int
  receivedQty   Int

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  grn           GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([grnId])
  @@index([productId])
}

// ─── PURCHASE INVOICE ─────────────────────────────────────

model PurchaseInvoice {
  id               String                @id @default(cuid())
  displayId        String?               @unique
  tenantId         String                @default("VK001")
  storeId          String?
  vendorId         String
  poId             String?
  invoiceNumber    String
  invoiceDate      DateTime              @default(now())
  transportCharges Float                 @default(0)
  otherCharges     Float                 @default(0)
  totalAmount      Float                 @default(0)
  status           PurchaseInvoiceStatus @default(DRAFT)
  paidAmount       Float                 @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  store            Store?                @relation(fields: [storeId], references: [id])
  vendor           Vendor                @relation(fields: [vendorId], references: [id])
  po               PurchaseOrder?        @relation(fields: [poId], references: [id])
  items            PurchaseInvoiceItem[]
  paymentAllocations VendorPaymentAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([vendorId])
  @@index([poId])
  @@index([status])
}

model PurchaseInvoiceItem {
  id         String          @id @default(cuid())
  tenantId   String          @default("VK001")
  invoiceId  String
  productId  String
  quantity   Int
  price      Float
  total      Float           @default(0)

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([productId])
}

// ─── PROCUREMENT STOCK LEDGER ─────────────────────────────────────

model ProcurementStockLedger {
  id          String            @id @default(cuid())
  tenantId    String            @default("VK001")
  storeId     String?
  productId   String
  type        StockMovementType
  quantity    Int
  reference   String?           // Invoice/Order/Transfer ID
  refType     String?           // INVOICE, ORDER, TRANSFER
  balanceAfter Int              @default(0)
  createdAt   DateTime          @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  store       Store?            @relation(fields: [storeId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ─── VENDOR LEDGER ─────────────────────────────────────

model VendorLedger {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  storeId     String?
  vendorId    String
  date        DateTime         @default(now())
  type        VendorLedgerType
  debit       Float            @default(0)
  credit      Float            @default(0)
  balance     Float            @default(0)
  reference   String?          // Invoice or Payment ID
  description String?
  createdAt   DateTime         @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  store       Store?           @relation(fields: [storeId], references: [id])
  vendor      Vendor           @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([vendorId])
  @@index([date])
  @@index([type])
}

// ─── VENDOR PAYMENT ─────────────────────────────────────

model VendorPayment {
  id            String            @id @default(cuid())
  displayId     String?           @unique
  tenantId      String            @default("VK001")
  storeId       String?
  vendorId      String
  paymentDate   DateTime          @default(now())
  amount        Float
  mode          VendorPaymentMode
  referenceNo   String?
  isAdvance     Boolean           @default(false)
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  store         Store?            @relation(fields: [storeId], references: [id])
  vendor        Vendor            @relation(fields: [vendorId], references: [id])
  allocations   VendorPaymentAllocation[]

  @@index([tenantId])
  @@index([storeId])
  @@index([vendorId])
  @@index([paymentDate])
}

model VendorPaymentAllocation {
  id          String          @id @default(cuid())
  tenantId    String          @default("VK001")
  paymentId   String
  invoiceId   String
  amount      Float
  createdAt   DateTime        @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  payment     VendorPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([paymentId])
  @@index([invoiceId])
}

// ─── ID GENERATION SEQUENCE TRACKER ─────────────────────────────────────

model IdSequence {
  id         String   @id @default(cuid())
  tenantId   String   @default("VK001")
  entity     String   // VH, INV, ORD, PO, PINV, GRN, PAY, EMP, VA, ITM, VND, SES, EXP
  hub        String   // Hub code (e.g., PPM, GNT)
  period     String   @default("ALL") // "ALL" for continuous, "2026" for yearly, "20260413" for daily
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entity, hub, period])
  @@index([tenantId])
  @@index([entity, hub])
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  userId       String
  targetUserId String?  // Optional: User who the action is performed for
  action       String   // e.g. "SALE_CREATED", "REFILL_REQUESTED", "CASH_REPORTED"
  details      String?  // Text description
  metadata     Json?    // Optional structured data
  createdAt    DateTime @default(now())
  storeId      String?
  
  user         User     @relation("UserActions", fields: [userId], references: [id])
  targetUser   User?    @relation("TargetActions", fields: [targetUserId], references: [id])
  tenant       Tenant   @relation("TenantActivityLogs", fields: [tenantId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([storeId])
}

model BankDeposit {
  id              String   @id @default(cuid())
  tenantId        String   @default("VK001")
  storeId         String
  date            String   // YYYY-MM-DD
  dateTime        DateTime @default(now())
  amount          Float
  branchName      String
  receiptImage    String?
  depositedBy     String   // Name
  adminId         String?  // References User (the admin who recorded it)
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  store           Store    @relation(fields: [storeId], references: [id])
  admin           User?    @relation(fields: [adminId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
}

// ─── INVENTORY DAMAGE & DEDUCTION MODULE ─────────────────────────────────────

enum DamageType {
  DAMAGED
  EXPIRED
  LEAKAGE
  LOST
}

enum DamageStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum SelfResponsibility {
  SELF
  SYSTEM
  UNKNOWN
}

enum AdminResponsibility {
  VGE_RESPONSIBLE
  NEGLIGENCE
  INTENTIONAL
  MIS_HANDLING
  NOT_RESPONSIBLE
}

enum DeductionMode {
  FULL
  PARTIAL
  WAIVED
}

model DamageEntry {
  id                String              @id @default(cuid())
  displayId         String?             @unique
  tenantId          String              @default("VK001")
  storeId           String?
  vehicleId         String?
  reportedById      String              // The VGE/agent who reported
  productId         String
  quantity          Int
  damageType        DamageType
  selfResponsibility SelfResponsibility @default(UNKNOWN)
  reason            String
  images            String[]            // Array of image URLs
  geoLatitude       Float?
  geoLongitude      Float?
  status            DamageStatus        @default(PENDING)

  // Admin evaluation fields
  adminResponsibility AdminResponsibility?
  reviewedById      String?             // Admin who reviewed
  reviewedAt        DateTime?
  adminRemarks      String?

  // Financial fields
  purchaseCost      Float?              // Per-unit purchase cost at time of damage
  totalLoss         Float?              // quantity × purchaseCost

  // Stock adjustment tracking
  stockAdjusted     Boolean             @default(false)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  store             Store?              @relation(fields: [storeId], references: [id])
  vehicle           Vehicle?            @relation(fields: [vehicleId], references: [id])
  reportedBy        User                @relation("DamageReporter", fields: [reportedById], references: [id])
  reviewedBy        User?               @relation("DamageReviewer", fields: [reviewedById], references: [id])
  product           Product             @relation(fields: [productId], references: [id])
  deduction         DamageDeduction?

  @@index([tenantId])
  @@index([storeId])
  @@index([vehicleId])
  @@index([reportedById])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([damageType])
}

model DamageDeduction {
  id                String          @id @default(cuid())
  tenantId          String          @default("VK001")
  storeId           String?
  damageEntryId     String          @unique
  userId            String          // VGE who is being deducted
  mode              DeductionMode   @default(FULL)
  percentage        Float?          @default(100) // For partial deduction
  deductionAmount   Float           @default(0)
  month             String          // YYYY-MM format for payroll period
  status            String          @default("PENDING") // PENDING, APPLIED, DISPUTED, CANCELLED
  appliedById       String?         // Admin who applied deduction
  appliedAt         DateTime?
  remarks           String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  store             Store?          @relation(fields: [storeId], references: [id])
  damageEntry       DamageEntry     @relation(fields: [damageEntryId], references: [id])
  user              User            @relation("DeductionTarget", fields: [userId], references: [id])
  appliedBy         User?           @relation("DeductionApplier", fields: [appliedById], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([damageEntryId])
  @@index([month])
  @@index([status])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

enum UserRole {
  CONSUMER
  ADMIN
  SALES_AGENT
  SUPERVISOR
  HELPER
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  LOAD
  RETURN
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String   @unique
  password          String
  mobile            String?  @unique
  role              UserRole @default(CONSUMER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assignedVehicleId String?
  dailyTarget       Float    @default(10000)

  assignedVehicle Vehicle?      @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  orders          Order[]
  carts           Cart[]
  openingCash     OpeningCash[]
  closingCash     ClosingCash[]

  status            UserStatus @default(ACTIVE)

  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  price              Float
  image              String?
  categoryId         String
  subCategoryId      String
  brandId            String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  mrp                Float?
  status             ItemStatus           @default(ACTIVE)
  discount           Float?
  landingPrice       Float?
  gst                Float?               @default(0)
  isFree             Boolean              @default(false)
  minShopAmount      Float                @default(0)
  category           Category             @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory          @relation(fields: [subCategoryId], references: [id])
  brand              Brand                @relation(fields: [brandId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Warehouse {
  id        String               @id @default(cuid())
  name      String
  location  String?
  inventory WarehouseInventory[]
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id])
}

model Order {
  id           String       @id @default(cuid())
  userId       String?
  agentId      String?
  totalAmount  Float
  status       OrderStatus  @default(PENDING)
  paymentMode  PaymentMode?
  mobile       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  vehicleId    String?
  orderNumber  Int          @unique @default(autoincrement())
  customerName String?

  user    User?       @relation(fields: [userId], references: [id])
  vehicle Vehicle?    @relation(fields: [vehicleId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float? @default(0)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  status      String
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id])
}

model Vehicle {
  id                String  @id @default(cuid())
  vehicleNumber     String  @unique
  status            Boolean @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?

  assignedUsers  User[]             @relation("UserVehicle")
  stocks         VehicleStock[]
  transactions   StockTransaction[]
  orders         Order[]
  openingCash    OpeningCash[]
  closingCash    ClosingCash[]
  dailySummaries DailyCashSummary[]
}

model VehicleStock {
  id        String  @id @default(cuid())
  vehicleId String
  productId String
  quantity  Int     @default(0)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([vehicleId, productId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
}

model OpeningCash {
  id               String   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  date             String // YYYY-MM-DD
  denominations    Json // Counts of 500, 200, 100, 50, 20, 10
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())

  @@unique([vehicleId, date])
}

model ClosingCash {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          String // YYYY-MM-DD
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json // Counts of 500, 200, 100, 50, 20, 10
  remark        String?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  @@unique([vehicleId, date])
}
model BusinessSettings {
  id           String   @id @default("singleton")
  businessName String   @default("VillagKart")
  gstNo        String?
  contactNo    String?
  email        String?
  address      String?  @db.Text
  taxRates     String   @default("0,5,12,18")
  updatedAt    DateTime @updatedAt
}


model DailyCashSummary {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  date         String // YYYY-MM-DD
  openingCash  Float    @default(0)
  cashSales    Float    @default(0)
  expectedCash Float    @default(0)
  actualCash   Float    @default(0)
  difference   Float    @default(0)
  status       String   @default("PENDING") // MATCHED, MISMATCHED, PENDING
  updatedAt    DateTime @updatedAt

  @@unique([vehicleId, date])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

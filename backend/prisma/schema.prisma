generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String            @unique
  password          String
  mobile            String?           @unique
  role              UserRole          @default(CONSUMER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedVehicleId String?
  dailyTarget       Float?            @default(10000)
  baseSalary        Float?            @default(12000)
  status            UserStatus        @default(ACTIVE)
  fcmToken          String?
  assignedVehicle   Vehicle?          @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  orders            Order[]
  carts             Cart[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  routeAssignments  RouteAssignment[]
  refillRequests    RefillRequest[]
  notifications     Notification[]
  dailyPerformance  VgeDailyPerformance[] @relation("UserDailyPerformance")
  monthlySummaries  VgeMonthlySummary[]   @relation("UserMonthlySummary")

  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  price              Float
  image              String?
  categoryId         String
  subCategoryId      String
  brandId            String
  unitId             String?
  unitValue          Float?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  mrp                Float?
  status             ItemStatus           @default(ACTIVE)
  discount           Float?
  landingPrice       Float?
  gst                Float?               @default(0)
  isFree             Boolean              @default(false)
  minShopAmount      Float                @default(0)
  category           Category             @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory          @relation(fields: [subCategoryId], references: [id])
  brand              Brand                @relation(fields: [brandId], references: [id])
  unit               Unit?                @relation(fields: [unitId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]
  refillItems        RefillItem[]

  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Warehouse {
  id        String               @id @default(cuid())
  name      String
  location  String?
  inventory WarehouseInventory[]
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id])
}

model Order {
  id           String        @id @default(cuid())
  userId       String?
  agentId      String?
  totalAmount  Float
  status       OrderStatus   @default(PENDING)
  paymentMode  PaymentMode?
  mobile       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicleId    String?
  orderNumber  Int           @unique @default(autoincrement())
  customerName String?
  coverageType CoverageType?
  routeId      String?
  villageName  String?
  user         User?         @relation(fields: [userId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  route        Route?        @relation(fields: [routeId], references: [id])
  items        OrderItem[]
  payment      Payment?

  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([routeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float?  @default(0)
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  status      String
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id])
}

model Vehicle {
  id                String             @id @default(cuid())
  vehicleNumber     String             @unique
  status            Boolean            @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  assignedUsers     User[]             @relation("UserVehicle")
  stocks            VehicleStock[]
  transactions      StockTransaction[]
  orders            Order[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  routeAssignments  RouteAssignment[]
  dailyCoverages    DailyCoverage[]
  refillRequests    RefillRequest[]
}

model VehicleStock {
  id        String  @id @default(cuid())
  vehicleId String
  productId String
  quantity  Int     @default(0)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([vehicleId, productId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])

  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
}

model Route {
  id          String            @id @default(cuid())
  routeName   String
  villages    String[]
  status      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  cycles      RouteCycle[]
  assignments RouteAssignment[]
  orders      Order[]
  monthlySummaries VgeMonthlySummary[]

  @@index([status])
}

model RouteCycle {
  id          String    @id @default(cuid())
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
}

model RouteAssignment {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime @default(now())
  status           Boolean  @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  route            Route    @relation(fields: [routeId], references: [id])

  @@index([vehicleId, status])
  @@index([userId, status])
}

model Village {
  id        String   @id @default(cuid())
  name      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpeningCash {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  date             String
  denominations    Json
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([vehicleId, date])
}

model ClosingCash {
  id            String   @id @default(cuid())
  vehicleId     String
  userId        String
  date          String
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([vehicleId, date])
}

model BusinessSettings {
  id           String   @id @default("singleton")
  businessName String   @default("VillagKart")
  gstNo        String?
  contactNo    String?
  email        String?
  address      String?
  taxRates     String   @default("0,5,12,18")
  updatedAt    DateTime @updatedAt
}

model DailyCashSummary {
  id           String   @id @default(cuid())
  vehicleId    String
  date         String
  openingCash  Float    @default(0)
  cashSales    Float    @default(0)
  expectedCash Float    @default(0)
  actualCash   Float    @default(0)
  difference   Float    @default(0)
  status       String   @default("PENDING")
  updatedAt    DateTime @updatedAt
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
}

model DailyCoverage {
  id          String   @id @default(cuid())
  vehicleId   String
  routeId     String?
  date        String
  villageName String
  morningDone Boolean  @default(false)
  eveningDone Boolean  @default(false)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([date])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  metadata  Json?
  priority  String    @default("low")
  role      UserRole?
  vehicleId String?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([role])
}

model RefillRequest {
  id        String       @id @default(cuid())
  vehicleId String
  userId    String
  status    RefillStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  items     RefillItem[]

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
}

model RefillItem {
  id              String        @id @default(cuid())
  refillRequestId String
  productId       String
  quantity        Int
  refillRequest   RefillRequest @relation(fields: [refillRequestId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([refillRequestId])
  @@index([productId])
}

enum UserRole {
  CONSUMER
  ADMIN
  SALES_AGENT
  SUPERVISOR
  HELPER
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum RefillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  LOAD
  RETURN
  AUDIT
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum CoverageType {
  MORNING
  EVENING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ─── VGE Targets & Incentives ─────────────────────────────

enum VgeLevel {
  NONE
  STARTER
  PERFORMER
  ACHIEVER
  CHAMPION
  STAR
  SUPER_STAR
}

model VgeDailyPerformance {
  id                  String   @id @default(cuid())
  userId              String
  date                String   // YYYY-MM-DD format
  routeId             String?

  // Raw aggregated data
  totalSales          Float    @default(0)
  totalRegistrations  Int      @default(0)
  completedOrders     Int      @default(0)

  // Derived from incentive engine
  eligibleSales       Float    @default(0)
  slabsCount          Int      @default(0)

  // Calculated output
  level               VgeLevel @default(NONE)
  salesIncentive      Float    @default(0)
  regIncentive        Float    @default(0)
  totalIncentive      Float    @default(0)

  // Lock for end-of-day finalization
  isLocked            Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation("UserDailyPerformance", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@index([level])
}

model VgeMonthlySummary {
  id                  String   @id @default(cuid())
  userId              String
  month               String   // YYYY-MM format
  routeId             String?
  route               Route?   @relation(fields: [routeId], references: [id])

  totalSales          Float    @default(0)
  totalRegistrations  Int      @default(0)
  totalIncentive      Float    @default(0)
  totalOrders         Int      @default(0)
  workingDays         Int      @default(0)
  avgLevel            String?  // Stored as string representation
  bestLevel           VgeLevel @default(NONE)
  metadata            Json?

  isLocked            Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation("UserMonthlySummary", fields: [userId], references: [id])

  @@unique([userId, month])
  @@index([month])
}

model VgeIncentiveConfig {
  id                      String   @id @default("singleton")

  // Minimum thresholds
  minSalesThreshold       Float    @default(10000)
  minRegThreshold         Int      @default(5)

  // Sales slab config
  salesSlabSize           Float    @default(5000)
  firstSlabCount          Int      @default(2)
  firstSlabIncentive      Float    @default(50)
  remainingSlabIncentive  Float    @default(100)

  // Registration incentive config
  firstRegCount           Int      @default(10)
  firstRegIncentive       Float    @default(10)
  remainingRegIncentive   Float    @default(15)

  // Level thresholds (in ascending sales order)
  starterThreshold        Float    @default(10000)
  performerThreshold      Float    @default(15000)
  achieverThreshold       Float    @default(20000)
  championThreshold       Float    @default(25000)
  starThreshold           Float    @default(30000)
  superStarThreshold      Float    @default(35000)

  updatedAt               DateTime @updatedAt
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

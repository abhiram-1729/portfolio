model BankDeposit {
  id           String   @id @default(cuid())
  tenantId     String   @default("VK001")
  storeId      String
  date         String
  dateTime     DateTime @default(now())
  amount       Float
  branchName   String
  receiptImage String?
  depositedBy  String
  adminId      String?
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  store        Store    @relation(fields: [storeId], references: [id])
  admin        User?    @relation(fields: [adminId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
}

model DamageEntry {
  id                  String               @id @default(cuid())
  displayId           String?              @unique
  tenantId            String               @default("VK001")
  storeId             String?
  vehicleId           String?
  reportedById        String
  productId           String
  quantity            Int
  damageType          DamageType
  selfResponsibility  SelfResponsibility   @default(UNKNOWN)
  reason              String
  images              String[]
  geoLatitude         Float?
  geoLongitude        Float?
  status              DamageStatus         @default(PENDING)
  adminResponsibility AdminResponsibility?
  reviewedById        String?
  reviewedAt          DateTime?
  adminRemarks        String?
  purchaseCost        Float?
  totalLoss           Float?
  stockAdjusted       Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  store               Store?               @relation(fields: [storeId], references: [id])
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id])
  reportedBy          User                 @relation("DamageReporter", fields: [reportedById], references: [id])
  reviewedBy          User?                @relation("DamageReviewer", fields: [reviewedById], references: [id])
  product             Product              @relation(fields: [productId], references: [id])
  deduction           DamageDeduction?

  @@index([tenantId])
  @@index([storeId])
  @@index([vehicleId])
  @@index([reportedById])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([damageType])
}

model DamageDeduction {
  id              String        @id @default(cuid())
  tenantId        String        @default("VK001")
  storeId         String?
  damageEntryId   String        @unique
  userId          String
  mode            DeductionMode @default(FULL)
  percentage      Float?        @default(100)
  deductionAmount Float         @default(0)
  month           String
  status          String        @default("PENDING")
  appliedById     String?
  appliedAt       DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  store           Store?        @relation(fields: [storeId], references: [id])
  damageEntry     DamageEntry   @relation(fields: [damageEntryId], references: [id])
  user            User          @relation("DeductionTarget", fields: [userId], references: [id])
  appliedBy       User?         @relation("DeductionApplier", fields: [appliedById], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([damageEntryId])
  @@index([month])
  @@index([status])
}

model OrderReturn {
  id           String   @id @default(cuid())
  tenantId     String   @default("VK001")
  storeId      String?
  orderId      String
  orderItemId  String
  productId    String
  returnQty    Int
  returnAmount Float
  reason       String?
  returnedById String
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}

model SessionSales {
  id                String    @id @default(cuid())
  tenantId          String    @default("VK001")
  storeId           String?
  date              String
  shift             Int       @default(1)
  agentId           String?
  vehicleId         String?
  totalSales        Float     @default(0)
  totalReturns      Float     @default(0)
  netSales          Float     @default(0)
  cashSales         Float     @default(0)
  upiSales          Float     @default(0)
  creditSales       Float     @default(0)
  totalOrders       Int       @default(0)
  totalReturnOrders Int       @default(0)
  isFrozen          Boolean   @default(false)
  frozenAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  store             Store?    @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, date, shift, agentId])
  @@index([tenantId])
  @@index([storeId])
  @@index([date])
  @@index([agentId])
}


// ─── VGE Targets & Incentives ─────────────────────────────

enum VgeLevel {
  NONE
  STARTER
  PERFORMER
  ACHIEVER
  CHAMPION
  STAR
  SUPER_STAR
}

model VgeDailyPerformance {
  id       String  @id @default(cuid())
  tenantId String  @default("VK001")
  userId   String
  date     String // YYYY-MM-DD format
  routeId  String?

  // Raw aggregated data
  totalSales         Float @default(0)
  totalRegistrations Int   @default(0)
  completedOrders    Int   @default(0)

  // Derived from incentive engine
  eligibleSales Float @default(0)
  slabsCount    Int   @default(0)

  // Calculated output
  level          String   @default("NONE")
  salesIncentive Float    @default(0)
  regIncentive   Float    @default(0)
  totalIncentive Float    @default(0)

  // Lock for end-of-day finalization
  isLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String?

  user  User   @relation("UserDailyPerformance", fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([level])
  @@index([storeId])
}

model VgeMonthlySummary {
  id       String  @id @default(cuid())
  tenantId String  @default("VK001")
  userId   String
  month    String // YYYY-MM format
  routeId  String?
  route    Route?  @relation(fields: [routeId], references: [id])

  totalSales         Float    @default(0)
  totalRegistrations Int      @default(0)
  totalIncentive     Float    @default(0)
  totalOrders        Int      @default(0)
  workingDays        Int      @default(0)
  avgLevel           String? // Stored as string representation
  bestLevel          VgeLevel @default(NONE)
  metadata           Json?

  isLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String?

  user  User   @relation("UserMonthlySummary", fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, month])
  @@index([tenantId])
  @@index([month])
  @@index([storeId])
}

model VgeIncentiveConfig {
  id       String @id @default(cuid())
  tenantId String  @default("VK001")
  storeId  String?

  // Minimum thresholds
  minSalesThreshold Float @default(10000)
  minRegThreshold   Int   @default(5)

  // Sales slab config
  salesSlabSize          Float @default(5000)
  firstSlabCount         Int   @default(2)
  firstSlabIncentive     Float @default(50)
  remainingSlabIncentive Float @default(100)

  // Registration incentive config
  firstRegCount         Int   @default(10)
  firstRegIncentive     Float @default(10)
  remainingRegIncentive Float @default(15)

  // Level thresholds (in ascending sales order)
  starterThreshold   Float @default(10000)
  performerThreshold Float @default(15000)
  achieverThreshold  Float @default(20000)
  championThreshold  Float @default(25000)
  starThreshold      Float @default(30000)
  superStarThreshold Float @default(35000)

  // Custom tabular rules
  rules      Json  @default("[]")
  baseSalary Float @default(15000)

  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model Unit {
  id        String    @id @default(cuid())
  tenantId  String    @default("VK001")
  storeId   String?
  name      String
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  store     Store?    @relation(fields: [storeId], references: [id])
  products  Product[]

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

// ─── Asset Management ─────────────────────────────────────

enum AssetType {
  ELECTRONIC
  NON_ELECTRONIC
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  LOST
  REPAIR_NEEDED
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  USED
  DAMAGED
}

enum AssetIssueType {
  NOT_WORKING
  DAMAGED
  OTHER
}

enum AssetIssueStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Asset {
  id            String         @id @default(cuid())
  tenantId      String         @default("VK001")
  name          String
  categoryId    String? // Link to dynamic categories
  assetType     String? // Legacy fallback/Direct name
  model         String?
  brand         String?
  image         String?
  description   String?
  estimatedCost Float          @default(0)
  totalQuantity Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  storeId       String?
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  category      AssetCategory? @relation(fields: [categoryId], references: [id])
  store         Store?         @relation(fields: [storeId], references: [id])
  units         AssetUnit[]
  requests      AssetRequest[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([storeId])
}

model AssetCategory {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  name      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])
  assets    Asset[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([storeId])
}

model AssetUnit {
  id           String            @id @default(cuid())
  tenantId     String            @default("VK001")
  assetId      String
  serialNumber String?
  status       AssetStatus       @default(AVAILABLE)
  condition    AssetCondition    @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignments  AssetAssignment[]
  issues       AssetIssue[]
  requests     AssetRequest[]

  @@unique([assetId, serialNumber])
  @@index([tenantId])
  @@index([assetId])
  @@index([status])
}

model AssetAssignment {
  id              String          @id @default(cuid())
  tenantId        String          @default("VK001")
  assetUnitId     String
  userId          String
  assignedDate    DateTime        @default(now())
  returnDate      DateTime?
  assignCondition AssetCondition  @default(NEW)
  returnCondition AssetCondition?
  returnRemarks   String?
  quantity        Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assetUnit       AssetUnit       @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([isActive])
}

model AssetIssue {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  assetUnitId String
  userId      String
  issueType   AssetIssueType
  description String?
  photos      String[]
  status      AssetIssueStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assetUnit   AssetUnit        @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([status])
}

model AssetRequest {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  userId      String
  type        AssetRequestType
  assetId     String? // Reference to asset if requesting specific type
  assetUnitId String? // Reference to existing unit if replacement
  description String? // Specific details or "New Requirement" text
  priority    String           @default("MEDIUM")
  status      RequestStatus    @default(PENDING)
  adminRemark String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User       @relation("UserAssetRequests", fields: [userId], references: [id])
  asset     Asset?     @relation(fields: [assetId], references: [id])
  assetUnit AssetUnit? @relation(fields: [assetUnitId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum AssetRequestType {
  REPLACEMENT
  NEW_ASSET
  NEW_REQUIREMENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model LocationCheckIn {
  id                String   @id @default(cuid())
  tenantId          String   @default("VK001")
  userId            String
  date              String // YYYY-MM-DD
  time              DateTime @default(now())
  latitude          Float
  longitude         Float
  villageName       String?
  status            String // ON_TIME, LATE
  isLocationMatched Boolean  @default(true)
  createdAt         DateTime @default(now())
  storeId           String?
  user              User     @relation(fields: [userId], references: [id])
  store             Store?   @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model Store {
  id           String   @id @default(cuid())
  tenantId     String   @default("VK001")
  name         String
  code         String   @unique
  stateCode    String   @default("AP")
  hubCode      String   @default("HUB")
  address      String?
  contactEmail String?
  contactPhone String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  users    User[]
  vehicles Vehicle[]

  // Store-scoped relations
  orders           Order[]
  openingCash      OpeningCash[]
  closingCash      ClosingCash[]
  dailySummaries   DailyCashSummary[]
  storeCashRegisters StoreCashRegister[]
  storeDeposits    StoreDeposit[]
  expenses         Expense[]
  cashTransfers    CashTransfer[]
  dailyCoverages   DailyCoverage[]
  notifications    Notification[]
  refillRequests   RefillRequest[]
  dailyPerformance VgeDailyPerformance[]
  monthlySummaries VgeMonthlySummary[]
  assets             Asset[]
  checkIns           LocationCheckIn[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  products           Product[]
  refillItems        RefillItem[]
  orderItems         OrderItem[]
  payments           Payment[]
  routes             Route[]
  bankDeposits       BankDeposit[]
  villages           Village[]
  assetCategories    AssetCategory[]
  incentiveConfigs   VgeIncentiveConfig[]
  businessSettings   BusinessSettings?
  categories         Category[]
  units              Unit[]
  stockAudits        StockAudit[]
  // Damage & Deduction store-scoped relations

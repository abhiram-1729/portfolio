generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  contactEmail String?
  contactPhone String?
  address      String?
  logo         String?
  status       TenantStatus @default(ACTIVE)
  planName     String       @default("FREE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Ownership Relations
  users             User[]
  categories        Category[]
  brands            Brand[]
  products          Product[]
  warehouses        Warehouse[]
  orders            Order[]
  vehicles          Vehicle[]
  routes            Route[]
  villages          Village[]
  expenseCategories ExpenseCategory[]
  units             Unit[]
  assets            Asset[]
  businessSettings  BusinessSettings[]
  incentiveConfig   VgeIncentiveConfig?
  orderItems        OrderItem[]
  payments          Payment[]
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(cuid())
  tenantId          String     @default("VK001") // Temp default for migration
  name              String?
  email             String     @unique
  password          String
  mobile            String?    @unique
  role              UserRole   @default(CONSUMER)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedVehicleId String?
  dailyTarget       Float?     @default(10000)
  baseSalary        Float?     @default(12000)
  status            UserStatus @default(ACTIVE)
  vgeType           String     @default("EMPLOYEE") // EMPLOYEE or FREELANCER
  fcmToken          String?

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  assignedVehicle  Vehicle?              @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  orders           Order[]
  carts            Cart[]
  openingCash      OpeningCash[]
  closingCash      ClosingCash[]
  routeAssignments RouteAssignment[]
  refillRequests   RefillRequest[]
  notifications    Notification[]
  dailyPerformance VgeDailyPerformance[] @relation("UserDailyPerformance")
  monthlySummaries VgeMonthlySummary[]   @relation("UserMonthlySummary")
  assetAssignments AssetAssignment[]
  assetIssues      AssetIssue[]
  expenses         Expense[]
  cashTransfers    CashTransfer[]
  dailySummaries   DailyCashSummary[]    @relation("UserDailyCashSummary")
  assetRequests    AssetRequest[]        @relation("UserAssetRequests")
  locationCheckIns LocationCheckIn[]


  @@index([tenantId])
  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
}

model Category {
  id            String        @id @default(cuid())
  tenantId      String        @default("VK001")
  name          String
  subCategories SubCategory[]
  products      Product[]
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SubCategory {
  id         String    @id @default(cuid())
  tenantId   String    @default("VK001")
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@index([tenantId])
}

model Brand {
  id       String    @id @default(cuid())
  tenantId String    @default("VK001")
  name     String
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id            String     @id @default(cuid())
  tenantId      String     @default("VK001")
  name          String
  description   String?
  price         Float
  image         String?
  categoryId    String
  subCategoryId String
  brandId       String
  unitId        String?
  unitValue     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  mrp           Float?
  status        ItemStatus @default(ACTIVE)
  discount      Float?
  landingPrice  Float?
  gst           Float?     @default(0)
  isFree        Boolean    @default(false)
  minShopAmount Float      @default(0)

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  category           Category             @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory          @relation(fields: [subCategoryId], references: [id])
  brand              Brand                @relation(fields: [brandId], references: [id])
  unit               Unit?                @relation(fields: [unitId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]
  refillItems        RefillItem[]

  @@index([tenantId])
  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  tenantId  String  @default("VK001")
  name      String
  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
}

model Warehouse {
  id        String               @id @default(cuid())
  tenantId  String               @default("VK001")
  name      String
  location  String?
  inventory WarehouseInventory[]
  tenant    Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  tenantId  String     @default("VK001")
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        String @id @default(cuid())
  tenantId  String @default("VK001")
  cartId    String
  productId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@index([tenantId])
}

model Order {
  id           String        @id @default(cuid())
  tenantId     String        @default("VK001")
  userId       String?
  agentId      String?
  totalAmount  Float
  status       OrderStatus   @default(PENDING)
  paymentMode  PaymentMode?
  mobile       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicleId    String?
  orderNumber  Int           @unique @default(autoincrement())
  customerName String?
  coverageType CoverageType?
  routeId      String?
  villageName  String?
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  route        Route?        @relation(fields: [routeId], references: [id])
  items        OrderItem[]
  payment      Payment?

  @@index([tenantId])
  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([routeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  tenantId     String  @default("VK001")
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float?  @default(0)
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  tenant       Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  tenantId    String      @default("VK001")
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  status      String
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Vehicle {
  id                String             @id @default(cuid())
  tenantId          String             @default("VK001")
  vehicleNumber     String
  status            Boolean            @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  assignedUsers     User[]             @relation("UserVehicle")
  stocks            VehicleStock[]
  transactions      StockTransaction[]
  orders            Order[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  routeAssignments  RouteAssignment[]
  dailyCoverages    DailyCoverage[]
  refillRequests    RefillRequest[]
  expenses          Expense[]
  cashTransfers     CashTransfer[]

  @@unique([tenantId, vehicleNumber])
  @@index([tenantId])
}

model VehicleStock {
  id              String  @id @default(cuid())
  tenantId        String  @default("VK001")
  vehicleId       String
  productId       String
  quantity        Int     @default(0)
  openingQuantity Int     @default(0)
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  product         Product @relation(fields: [productId], references: [id])

  @@unique([vehicleId, productId])
  @@index([tenantId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  tenantId  String          @default("VK001")
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
}

model Route {
  id               String              @id @default(cuid())
  tenantId         String              @default("VK001")
  routeName        String
  villages         String[]
  status           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  cycles           RouteCycle[]
  assignments      RouteAssignment[]
  orders           Order[]
  monthlySummaries VgeMonthlySummary[]

  @@index([tenantId])
  @@index([status])
}

model RouteCycle {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
  @@index([tenantId])
}

model RouteAssignment {
  id               String   @id @default(cuid())
  tenantId         String   @default("VK001")
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime @default(now())
  status           Boolean  @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  route            Route    @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([userId, status])
}

model Village {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  name      String
  latitude  Float?
  longitude Float?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model OpeningCash {
  id               String   @id @default(cuid())
  tenantId         String   @default("VK001")
  vehicleId        String
  userId           String
  date             String
  shift            Int      @default(1) // 1 = Morning, 2 = Afternoon
  denominations    Json
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
}

model ClosingCash {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  vehicleId     String
  userId        String
  date          String
  shift         Int      @default(1) // 1 = Morning, 2 = Afternoon
  openingCash   Float
  cashSales     Float
  expenses      Float    @default(0)
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
}

model BusinessSettings {
  id           String   @id @default(cuid())
  tenantId     String   @unique @default("VK001")
  businessName String   @default("VillagKart")
  gstNo        String?
  contactNo    String?
  email        String?
  address      String?
  taxRates     String   @default("0,5,12,18")
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model DailyCashSummary {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  vehicleId     String
  userId        String?
  date          String
  openingCash   Float    @default(0)
  cashSales     Float    @default(0)
  expenses      Float    @default(0)
  expectedCash  Float    @default(0)
  actualCash    Float    @default(0)
  difference    Float    @default(0)
  status        String   @default("PENDING")
  submittedCash Float    @default(0)
  updatedAt     DateTime @updatedAt
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User?    @relation("UserDailyCashSummary", fields: [userId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
}

model Expense {
  id          String             @id @default(cuid())
  tenantId    String             @default("VK001")
  userId      String
  vehicleId   String?
  type        String // e.g. FUEL, FOOD, etc (to match dynamic management)
  amount      Float
  paymentMode ExpensePaymentMode
  description String?
  billImage   String?
  status      ExpenseStatus      @default(PENDING)
  date        String // YYYY-MM-DD
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
}

model CashTransfer {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  userId        String
  vehicleId     String
  date          String // YYYY-MM-DD
  amount        Float
  denominations Json?
  status        String   @default("SUBMITTED") // SUBMITTED, RECEIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([userId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  name      String
  limit     Float?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum ExpensePaymentMode {
  CASH
  UPI
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model DailyCoverage {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  vehicleId   String
  routeId     String?
  date        String
  villageName String
  morningDone Boolean  @default(false)
  eveningDone Boolean  @default(false)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default("VK001")
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  metadata  Json?
  priority  String    @default("low")
  role      UserRole?
  vehicleId String?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([role])
}

model RefillRequest {
  id        String       @id @default(cuid())
  tenantId  String       @default("VK001")
  vehicleId String
  userId    String
  status    RefillStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  items     RefillItem[]

  @@index([tenantId])
  @@index([vehicleId])
  @@index([userId])
  @@index([status])
}

model RefillItem {
  id                String        @id @default(cuid())
  tenantId          String        @default("VK001")
  refillRequestId   String
  productId         String
  quantity          Int
  requestedQuantity Int?
  adminRemark       String?
  refillRequest     RefillRequest @relation(fields: [refillRequestId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([refillRequestId])
  @@index([productId])
}

enum UserRole {
  CONSUMER
  SUPER_ADMIN
  TENANT_OWNER
  ADMIN
  SALES_AGENT
  SUPERVISOR
  HELPER
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum RefillStatus {
  PENDING
  APPROVED
  PARTIAL
  REJECTED
}

enum TransactionType {
  LOAD
  RETURN
  AUDIT
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum CoverageType {
  MORNING
  EVENING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ─── VGE Targets & Incentives ─────────────────────────────

enum VgeLevel {
  NONE
  STARTER
  PERFORMER
  ACHIEVER
  CHAMPION
  STAR
  SUPER_STAR
}

model VgeDailyPerformance {
  id       String  @id @default(cuid())
  tenantId String  @default("VK001")
  userId   String
  date     String // YYYY-MM-DD format
  routeId  String?

  // Raw aggregated data
  totalSales         Float @default(0)
  totalRegistrations Int   @default(0)
  completedOrders    Int   @default(0)

  // Derived from incentive engine
  eligibleSales Float @default(0)
  slabsCount    Int   @default(0)

  // Calculated output
  level          VgeLevel @default(NONE)
  salesIncentive Float    @default(0)
  regIncentive   Float    @default(0)
  totalIncentive Float    @default(0)

  // Lock for end-of-day finalization
  isLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserDailyPerformance", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([level])
}

model VgeMonthlySummary {
  id       String  @id @default(cuid())
  tenantId String  @default("VK001")
  userId   String
  month    String // YYYY-MM format
  routeId  String?
  route    Route?  @relation(fields: [routeId], references: [id])

  totalSales         Float    @default(0)
  totalRegistrations Int      @default(0)
  totalIncentive     Float    @default(0)
  totalOrders        Int      @default(0)
  workingDays        Int      @default(0)
  avgLevel           String? // Stored as string representation
  bestLevel          VgeLevel @default(NONE)
  metadata           Json?

  isLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserMonthlySummary", fields: [userId], references: [id])

  @@unique([userId, month])
  @@index([tenantId])
  @@index([month])
}

model VgeIncentiveConfig {
  id       String @id @default(cuid())
  tenantId String @unique @default("VK001")

  // Minimum thresholds
  minSalesThreshold Float @default(10000)
  minRegThreshold   Int   @default(5)

  // Sales slab config
  salesSlabSize          Float @default(5000)
  firstSlabCount         Int   @default(2)
  firstSlabIncentive     Float @default(50)
  remainingSlabIncentive Float @default(100)

  // Registration incentive config
  firstRegCount         Int   @default(10)
  firstRegIncentive     Float @default(10)
  remainingRegIncentive Float @default(15)

  // Level thresholds (in ascending sales order)
  starterThreshold   Float @default(10000)
  performerThreshold Float @default(15000)
  achieverThreshold  Float @default(20000)
  championThreshold  Float @default(25000)
  starThreshold      Float @default(30000)
  superStarThreshold Float @default(35000)

  // Custom tabular rules
  rules      Json  @default("[]")
  baseSalary Float @default(15000)

  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Unit {
  id        String    @id @default(cuid())
  tenantId  String    @default("VK001")
  name      String
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─── Asset Management ─────────────────────────────────────

enum AssetType {
  ELECTRONIC
  NON_ELECTRONIC
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  LOST
  REPAIR_NEEDED
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  USED
  DAMAGED
}

enum AssetIssueType {
  NOT_WORKING
  DAMAGED
  OTHER
}

enum AssetIssueStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Asset {
  id            String         @id @default(cuid())
  tenantId      String         @default("VK001")
  name          String
  assetType     AssetType
  model         String?
  brand         String?
  image         String?
  description   String?
  estimatedCost Float          @default(0)
  totalQuantity Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  units         AssetUnit[]
  requests      AssetRequest[]

  @@index([tenantId])
  @@index([assetType])
}

model AssetUnit {
  id           String            @id @default(cuid())
  tenantId     String            @default("VK001")
  assetId      String
  serialNumber String?
  status       AssetStatus       @default(AVAILABLE)
  condition    AssetCondition    @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignments  AssetAssignment[]
  issues       AssetIssue[]
  requests     AssetRequest[]

  @@unique([assetId, serialNumber])
  @@index([tenantId])
  @@index([assetId])
  @@index([status])
}

model AssetAssignment {
  id              String          @id @default(cuid())
  tenantId        String          @default("VK001")
  assetUnitId     String
  userId          String
  assignedDate    DateTime        @default(now())
  returnDate      DateTime?
  assignCondition AssetCondition  @default(NEW)
  returnCondition AssetCondition?
  returnRemarks   String?
  quantity        Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assetUnit       AssetUnit       @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([isActive])
}

model AssetIssue {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  assetUnitId String
  userId      String
  issueType   AssetIssueType
  description String?
  photos      String[]
  status      AssetIssueStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assetUnit   AssetUnit        @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([status])
}

model AssetRequest {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  userId      String
  type        AssetRequestType
  assetId     String? // Reference to asset if requesting specific type
  assetUnitId String? // Reference to existing unit if replacement
  description String? // Specific details or "New Requirement" text
  priority    String           @default("MEDIUM")
  status      RequestStatus    @default(PENDING)
  adminRemark String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User       @relation("UserAssetRequests", fields: [userId], references: [id])
  asset     Asset?     @relation(fields: [assetId], references: [id])
  assetUnit AssetUnit? @relation(fields: [assetUnitId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum AssetRequestType {
  REPLACEMENT
  NEW_ASSET
  NEW_REQUIREMENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model LocationCheckIn {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  userId      String
  date        String   // YYYY-MM-DD
  time        DateTime @default(now())
  latitude    Float
  longitude   Float
  villageName String?
  status            String   // ON_TIME, LATE
  isLocationMatched Boolean  @default(true)
  createdAt         DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([date])
}


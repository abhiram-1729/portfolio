generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  contactEmail String?
  contactPhone String?
  address      String?
  logo         String?
  status       TenantStatus @default(ACTIVE)
  planName     String       @default("FREE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Ownership Relations
  users             User[]
  categories        Category[]
  brands            Brand[]
  products          Product[]
  warehouses        Warehouse[]
  orders            Order[]
  vehicles          Vehicle[]
  routes            Route[]
  villages          Village[]
  expenseCategories ExpenseCategory[]
  units             Unit[]
  assets            Asset[]
  businessSettings  BusinessSettings[]
  incentiveConfig   VgeIncentiveConfig[]
  orderItems        OrderItem[]
  payments          Payment[]
  assetCategories   AssetCategory[]
  stores            Store[]
  stockAudits       StockAudit[]
  stockAuditItems   StockAuditItem[]
  refillItems       RefillItem[]
  dailyPerformance  VgeDailyPerformance[]
  monthlySummaries  VgeMonthlySummary[]
  assetRequests     AssetRequest[]
  customRoles       CustomRole[]
  activityLogs      ActivityLog[] @relation("TenantActivityLogs")
  storeCashRegisters StoreCashRegister[]
  storeDeposits      StoreDeposit[]
  // Procurement Relations
  vendors                Vendor[]
  vendorItemMappings     VendorItemMapping[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsReceipts          GoodsReceipt[]
  goodsReceiptItems      GoodsReceiptItem[]
  purchaseInvoices       PurchaseInvoice[]
  purchaseInvoiceItems   PurchaseInvoiceItem[]
  safeTransactions       SafeTransaction[]
  procurementStockLedger ProcurementStockLedger[]
  vendorLedger           VendorLedger[]
  vendorPayments         VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]
  // Damage & Deduction Relations
  damageEntries          DamageEntry[]
  damageDeductions       DamageDeduction[]
  // ID Generation
  idSequences            IdSequence[]
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(cuid())
  displayId         String?    @unique
  tenantId          String     @default("VK001") // Temp default for migration
  name              String?
  email             String     @unique
  password          String
  mobile            String?    @unique
  role              UserRole   @default(CONSUMER)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedVehicleId String?
  storeId           String?
  dailyTarget       Float?     @default(10000)
  baseSalary        Float?     @default(12000)
  status            UserStatus @default(ACTIVE)
  vgeType           String     @default("EMPLOYEE") // EMPLOYEE or FREELANCER
  fcmToken          String?
  customRoleId      String?

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  assignedVehicle  Vehicle?              @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  store            Store?                @relation(fields: [storeId], references: [id])
  customRole       CustomRole?           @relation(fields: [customRoleId], references: [id])
  orders           Order[]
  carts            Cart[]
  openingCash      OpeningCash[]
  closingCash      ClosingCash[]
  routeAssignments RouteAssignment[]
  refillRequests   RefillRequest[]
  notifications    Notification[]
  dailyPerformance VgeDailyPerformance[] @relation("UserDailyPerformance")
  monthlySummaries VgeMonthlySummary[]   @relation("UserMonthlySummary")
  assetAssignments AssetAssignment[]
  assetIssues      AssetIssue[]
  expenses         Expense[]
  cashTransfers    CashTransfer[]
  storeDeposits    StoreDeposit[]
  dailySummaries   DailyCashSummary[]    @relation("UserDailyCashSummary")
  assetRequests    AssetRequest[]        @relation("UserAssetRequests")
  locationCheckIns LocationCheckIn[]
  stockAudits      StockAudit[]
  bankDeposits     BankDeposit[]
  actions           ActivityLog[] @relation("UserActions")
  targetActions     ActivityLog[] @relation("TargetActions")
  damageReports     DamageEntry[] @relation("DamageReporter")
  damageReviews     DamageEntry[] @relation("DamageReviewer")
  deductionsReceived DamageDeduction[] @relation("DeductionTarget")
  deductionsApplied  DamageDeduction[] @relation("DeductionApplier")
  safeTransactions   SafeTransaction[]
  openedRegisters    StoreCashRegister[] @relation("OpenedRegisters")
  closedRegisters    StoreCashRegister[] @relation("ClosedRegisters")

  @@index([tenantId])
  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
  @@index([customRoleId])
}

model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json     // {"INVENTORY": ["READ","CREATE","UPDATE","DELETE"], ...}
  portalType  String   @default("ADMIN") // ADMIN, AGENT, SUPERVISOR, HELPER
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id            String        @id @default(cuid())
  tenantId      String        @default("VK001")
  storeId       String?
  name          String
  subCategories SubCategory[]
  products      Product[]
  
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  store         Store?        @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model SubCategory {
  id         String    @id @default(cuid())
  tenantId   String    @default("VK001")
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@index([tenantId])
}

model Brand {
  id       String    @id @default(cuid())
  tenantId String    @default("VK001")
  name     String
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id            String     @id @default(cuid())
  tenantId      String     @default("VK001")
  name          String
  description   String?
  price         Float
  image         String?
  categoryId    String
  subCategoryId String
  brandId       String
  unitId        String?
  unitValue     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  mrp           Float?
  status        ItemStatus @default(ACTIVE)
  discount      Float?
  landingPrice  Float?
  gst           Float?     @default(0)
  isFree        Boolean    @default(false)
  minShopAmount Float      @default(0)
  storeId       String?
  displayId     String?    @unique
  purchasePrice Float?     @default(0)
  minStockAlert Int?       @default(0)
  skuCode       String?
  barcode       String?
  stock         Int        @default(0)
  store         Store?     @relation(fields: [storeId], references: [id])

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  category           Category             @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory          @relation(fields: [subCategoryId], references: [id])
  brand              Brand                @relation(fields: [brandId], references: [id])
  unit               Unit?                @relation(fields: [unitId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]
  refillItems        RefillItem[]
  auditItems         StockAuditItem[]
  vendorMappings     VendorItemMapping[]
  poItems            PurchaseOrderItem[]
  grnItems           GoodsReceiptItem[]
  purchaseItems      PurchaseInvoiceItem[]
  damageEntries      DamageEntry[]
  procurementLedger  ProcurementStockLedger[]

  @@index([tenantId])
  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([storeId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  tenantId  String  @default("VK001")
  name      String
  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
}

model Warehouse {
  id        String               @id @default(cuid())
  tenantId  String               @default("VK001")
  name      String
  location  String?
  inventory WarehouseInventory[]
  tenant    Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  tenantId  String     @default("VK001")
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        String @id @default(cuid())
  tenantId  String @default("VK001")
  cartId    String
  productId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@index([tenantId])
}

model Order {
  id           String        @id @default(cuid())
  displayId    String?       @unique
  tenantId     String        @default("VK001")
  userId       String?
  agentId      String?
  totalAmount  Float
  status       OrderStatus   @default(PENDING)
  paymentMode  PaymentMode?
  cashAmount   Float?        @default(0)
  upiAmount    Float?        @default(0)
  mobile       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicleId    String?
  orderNumber  Int           @unique @default(autoincrement())
  customerName String?
  coverageType CoverageType?
  routeId      String?
  villageName  String?
  storeId      String?
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  route        Route?        @relation(fields: [routeId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  items        OrderItem[]
  payment      Payment?

  @@index([tenantId])
  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([routeId])
  @@index([storeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  tenantId     String  @default("VK001")
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float?  @default(0)
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  storeId      String?
  store        Store?  @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  tenantId    String      @default("VK001")
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  cashAmount  Float?      @default(0)
  upiAmount   Float?      @default(0)
  status      String
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  storeId     String?
  store       Store?      @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
}

model Vehicle {
  id                String             @id @default(cuid())
  displayId         String?            @unique
  tenantId          String             @default("VK001")
  vehicleNumber     String
  status            Boolean            @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  storeId           String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  store             Store?             @relation(fields: [storeId], references: [id])
  assignedUsers     User[]             @relation("UserVehicle")
  stocks            VehicleStock[]
  transactions      StockTransaction[]
  orders            Order[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  routeAssignments  RouteAssignment[]
  dailyCoverages    DailyCoverage[]
  refillRequests    RefillRequest[]
  expenses          Expense[]
  cashTransfers     CashTransfer[]
  stockAudits       StockAudit[]
  damageEntries     DamageEntry[]

  @@unique([tenantId, vehicleNumber])
  @@index([tenantId])
}

model VehicleStock {
  id              String  @id @default(cuid())
  tenantId        String  @default("VK001")
  storeId         String?
  vehicleId       String
  productId       String
  quantity        Int     @default(0)
  openingQuantity Int     @default(0)
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
  store           Store?  @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, productId])
  @@index([tenantId])
  @@index([storeId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  tenantId  String          @default("VK001")
  storeId   String?
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  store     Store?          @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
}

model Route {
  id               String              @id @default(cuid())
  tenantId         String              @default("VK001")
  routeName        String
  villages         String[]
  status           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  storeId          String?
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  store            Store?              @relation(fields: [storeId], references: [id])
  cycles           RouteCycle[]
  assignments      RouteAssignment[]
  orders           Order[]
  monthlySummaries VgeMonthlySummary[]

  @@unique([tenantId, storeId, routeName])
  @@index([tenantId])
  @@index([status])
  @@index([storeId])
}

model RouteCycle {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
  @@index([tenantId])
}

model RouteAssignment {
  id               String   @id @default(cuid())
  tenantId         String   @default("VK001")
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime @default(now())
  status           Boolean  @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  route            Route    @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([userId, status])
}

model Village {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  name      String
  latitude  Float?
  longitude Float?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model OpeningCash {
  id               String   @id @default(cuid())
  tenantId         String   @default("VK001")
  vehicleId        String
  userId           String
  date             String
  shift            Int      @default(1) // 1 = Morning, 2 = Afternoon
  denominations    Json
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  isNoService      Boolean  @default(false)
  createdAt        DateTime @default(now())
  storeId          String?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  store            Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model ClosingCash {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  vehicleId     String
  userId        String
  date          String
  shift         Int      @default(1) // 1 = Morning, 2 = Afternoon
  openingCash   Float
  cashSales     Float
  upiSales      Float    @default(0)
  cardSales     Float    @default(0)
  expenses      Float    @default(0)
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String   @default("SUBMITTED")
  isNoService   Boolean  @default(false)
  createdAt     DateTime @default(now())
  storeId       String?
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model BusinessSettings {
  id           String   @id @default(cuid())
  tenantId     String   @default("VK001")
  storeId      String?  @unique
  businessName String   @default("VillagKart")
  gstNo        String?
  contactNo    String?
  email        String?
  address      String?
  taxRates     String   @default("0,5,12,18")
  updatedAt    DateTime @updatedAt
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model DailyCashSummary {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  vehicleId     String
  userId        String?
  date          String
  openingCash   Float    @default(0)
  cashSales     Float    @default(0)
  upiSales      Float    @default(0)
  cardSales     Float    @default(0)
  expenses      Float    @default(0)
  expectedCash  Float    @default(0)
  actualCash    Float    @default(0)
  difference    Float    @default(0)
  status        String   @default("PENDING")
  submittedCash Float    @default(0)
  updatedAt     DateTime @updatedAt
  storeId       String?
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User?    @relation("UserDailyCashSummary", fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([storeId])
}

model StoreCashRegister {
  id                   String   @id @default(cuid())
  tenantId             String   @default("VK001")
  storeId              String
  date                 String
  
  openingCash          Float
  openingDenominations Json
  
  expectedClosingCash  Float?
  actualClosingCash    Float?
  closingDifference    Float?
  closingDenominations Json?
  closingRemarks       String?
  
  openedById           String?
  closedById           String?
  
  status               String   @default("OPEN") // OPEN, CLOSED
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  openedBy             User?    @relation("OpenedRegisters", fields: [openedById], references: [id])
  closedBy             User?    @relation("ClosedRegisters", fields: [closedById], references: [id])
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  store                Store    @relation(fields: [storeId], references: [id])
  
  @@unique([storeId, date])
  @@index([tenantId])
  @@index([openedById])
  @@index([closedById])
}

model StoreDeposit {
  id              String   @id @default(cuid())
  tenantId        String   @default("VK001")
  storeId         String
  date            String
  shift           Int
  amount          Float
  denominations   Json
  description     String
  userId          String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  store           Store    @relation(fields: [storeId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  
  @@unique([storeId, date, shift])
  @@index([tenantId])
}

model Expense {
  id          String             @id @default(cuid())
  displayId   String?            @unique
  tenantId    String             @default("VK001")
  userId      String
  vehicleId   String?
  type        String // e.g. FUEL, FOOD, etc (to match dynamic management)
  amount      Float
  paymentMode ExpensePaymentMode
  description String?
  billImage   String?
  status      ExpenseStatus      @default(PENDING)
  date        String // YYYY-MM-DD
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  storeId     String?
  user        User               @relation(fields: [userId], references: [id])
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])
  store       Store?             @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([storeId])
}

model CashTransfer {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  userId        String
  vehicleId     String
  date          String // YYYY-MM-DD
  amount        Float
  denominations Json?
  status        String   @default("SUBMITTED") // SUBMITTED, RECEIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  storeId       String?
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([userId])
  @@index([storeId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String   @default("VK001")
  name      String
  limit     Float?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum ExpensePaymentMode {
  CASH
  UPI
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model DailyCoverage {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  vehicleId   String
  routeId     String?
  date        String
  villageName String
  morningDone Boolean  @default(false)
  eveningDone Boolean  @default(false)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  storeId     String?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  store       Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([storeId])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default("VK001")
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  metadata  Json?
  priority  String    @default("low")
  role      UserRole?

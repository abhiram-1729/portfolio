generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Tenant {
  id                       String                    @id @default(cuid())
  name                     String
  code                     String                    @unique
  contactEmail             String?
  contactPhone             String?
  address                  String?
  logo                     String?
  status                   TenantStatus              @default(ACTIVE)
  planName                 String                    @default("FREE")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    User[]
  categories               Category[]
  brands                   Brand[]
  products                 Product[]
  warehouses               Warehouse[]
  orders                   Order[]
  orderReturns             OrderReturn[]
  vehicles                 Vehicle[]
  routes                   Route[]
  villages                 Village[]
  expenseCategories        ExpenseCategory[]
  units                    Unit[]
  assets                   Asset[]
  businessSettings         BusinessSettings[]
  incentiveConfig          VgeIncentiveConfig[]
  orderItems               OrderItem[]
  payments                 Payment[]
  sessionSales             SessionSales[]
  assetCategories          AssetCategory[]
  stores                   Store[]
  stockAudits              StockAudit[]
  stockAuditItems          StockAuditItem[]
  refillItems              RefillItem[]
  dailyPerformance         VgeDailyPerformance[]
  monthlySummaries         VgeMonthlySummary[]
  assetRequests            AssetRequest[]
  customRoles              CustomRole[]
  activityLogs             ActivityLog[]             @relation("TenantActivityLogs")
  storeCashRegisters       StoreCashRegister[]
  storeDeposits            StoreDeposit[]
  vendors                  Vendor[]
  vendorItemMappings       VendorItemMapping[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptItems        GoodsReceiptItem[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceItems     PurchaseInvoiceItem[]
  safeTransactions         SafeTransaction[]
  procurementStockLedger   ProcurementStockLedger[]
  vendorLedger             VendorLedger[]
  vendorPayments           VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]
  attendances              Attendance[]
  // Damage & Deduction Relations
  damageEntries            DamageEntry[]
  damageDeductions         DamageDeduction[]
  // Tracking Relations
  shiftLogs                ShiftLog[]
  villageActivities        VillageActivity[]
  locationLogs             LocationLog[]
  // ID Generation
  idSequences              IdSequence[]
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 String                @id @default(cuid())
  name               String?
  email              String                @unique
  password           String
  mobile             String?               @unique
  role               UserRole              @default(CONSUMER)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  assignedVehicleId  String?
  dailyTarget        Float?                @default(10000)
  status             UserStatus            @default(ACTIVE)
  fcmToken           String?
  baseSalary         Float?                @default(12000)
  tenantId           String                @default("VK001")
  vgeType            String                @default("EMPLOYEE")
  storeId            String?
  displayId          String?               @unique
  customRoleId       String?
  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  assignedVehicle    Vehicle?              @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  store              Store?                @relation(fields: [storeId], references: [id])
  customRole         CustomRole?           @relation(fields: [customRoleId], references: [id])
  orders             Order[]
  carts              Cart[]
  openingCash        OpeningCash[]
  closingCash        ClosingCash[]
  routeAssignments   RouteAssignment[]
  refillRequests     RefillRequest[]
  notifications      Notification[]
  stockTransactions  StockTransaction[]    @relation("UserStockTransactions")
  shiftLogs          ShiftLog[]
  attendances        Attendance[]
  dailyPerformance   VgeDailyPerformance[] @relation("UserDailyPerformance")
  monthlySummaries   VgeMonthlySummary[]   @relation("UserMonthlySummary")
  assetAssignments   AssetAssignment[]
  assetIssues        AssetIssue[]
  expenses           Expense[]
  cashTransfers      CashTransfer[]
  storeDeposits      StoreDeposit[]
  dailySummaries     DailyCashSummary[]    @relation("UserDailyCashSummary")
  assetRequests      AssetRequest[]        @relation("UserAssetRequests")
  locationCheckIns   LocationCheckIn[]
  stockAudits        StockAudit[]
  bankDeposits       BankDeposit[]
  actions            ActivityLog[]         @relation("UserActions")
  targetActions      ActivityLog[]         @relation("TargetActions")
  damageReports      DamageEntry[]         @relation("DamageReporter")
  damageReviews      DamageEntry[]         @relation("DamageReviewer")
  deductionsReceived DamageDeduction[]     @relation("DeductionTarget")
  deductionsApplied  DamageDeduction[]     @relation("DeductionApplier")
  safeTransactions   SafeTransaction[]
  openedRegisters    StoreCashRegister[]   @relation("OpenedRegisters")
  closedRegisters    StoreCashRegister[]   @relation("ClosedRegisters")
  villageActivities  VillageActivity[]
  locationLogs       LocationLog[]
  approvedRefills    RefillRequest[]       @relation("ApprovedRefills")

  @@index([tenantId])
  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
  @@index([customRoleId])
}

model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  portalType  String   @default("ADMIN")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  tenantId      String        @default("VK001")
  storeId       String?
  subCategories SubCategory[]
  products      Product[]
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  store         Store?        @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  tenantId   String    @default("VK001")
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@index([tenantId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  tenantId String    @default("VK001")
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                 String                   @id @default(cuid())
  name               String
  description        String?
  price              Float
  image              String?
  categoryId         String
  subCategoryId      String
  brandId            String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  mrp                Float?
  status             ItemStatus               @default(ACTIVE)
  discount           Float?
  landingPrice       Float?
  gst                Float?                   @default(0)
  isFree             Boolean                  @default(false)
  minShopAmount      Float                    @default(0)
  unitId             String?
  unitValue          Float?
  tenantId           String                   @default("VK001")
  storeId            String?
  barcode            String?
  minStockAlert      Int?                     @default(0)
  purchasePrice      Float?                   @default(0)
  skuCode            String?
  displayId          String?                  @unique
  stock              Int                      @default(0)
  store              Store?                   @relation(fields: [storeId], references: [id])
  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  category           Category                 @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory              @relation(fields: [subCategoryId], references: [id])
  brand              Brand                    @relation(fields: [brandId], references: [id])
  unit               Unit?                    @relation(fields: [unitId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]
  refillItems        RefillItem[]
  auditItems         StockAuditItem[]
  vendorMappings     VendorItemMapping[]
  poItems            PurchaseOrderItem[]
  grnItems           GoodsReceiptItem[]
  purchaseItems      PurchaseInvoiceItem[]
  damageEntries      DamageEntry[]
  procurementLedger  ProcurementStockLedger[]
  orderReturns       OrderReturn[]

  @@index([tenantId])
  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([storeId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  price     Float
  productId String
  tenantId  String  @default("VK001")
  product   Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
}

model Warehouse {
  id        String               @id @default(cuid())
  name      String
  location  String?
  tenantId  String               @default("VK001")
  inventory WarehouseInventory[]
  tenant    Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  tenantId    String    @default("VK001")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenantId  String     @default("VK001")
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  tenantId  String @default("VK001")
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@index([tenantId])
}

model Order {
  id           String        @id @default(cuid())
  userId       String?
  agentId      String?
  totalAmount  Float
  status       OrderStatus   @default(PENDING)
  paymentMode  PaymentMode?
  mobile       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicleId    String?
  orderNumber  Int           @unique @default(autoincrement())
  customerName String?
  coverageType CoverageType?
  routeId      String?
  villageName  String?
  tenantId     String        @default("VK001")
  storeId      String?
  displayId    String?       @unique
  cashAmount   Float?        @default(0)
  upiAmount    Float?        @default(0)
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  route        Route?        @relation(fields: [routeId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  items        OrderItem[]
  returns      OrderReturn[]
  payment      Payment?

  @@index([tenantId])
  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([routeId])
  @@index([storeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float?  @default(0)
  tenantId     String  @default("VK001")
  storeId      String?
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  store        Store?  @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  status      String
  createdAt   DateTime    @default(now())
  tenantId    String      @default("VK001")
  storeId     String?
  cashAmount  Float?      @default(0)
  upiAmount   Float?      @default(0)
  order       Order       @relation(fields: [orderId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  store       Store?      @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
}

model Vehicle {
  id                String             @id @default(cuid())
  vehicleNumber     String
  status            Boolean            @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  tenantId          String             @default("VK001")
  storeId           String?
  displayId         String?            @unique
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  store             Store?             @relation(fields: [storeId], references: [id])
  assignedUsers     User[]             @relation("UserVehicle")
  stocks            VehicleStock[]
  transactions      StockTransaction[]
  orders            Order[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  routeAssignments  RouteAssignment[]
  dailyCoverages    DailyCoverage[]
  refillRequests    RefillRequest[]
  expenses          Expense[]
  cashTransfers     CashTransfer[]
  stockAudits       StockAudit[]
  damageEntries     DamageEntry[]

  @@unique([tenantId, vehicleNumber])
  @@index([tenantId])
}

model VehicleStock {
  id              String  @id @default(cuid())
  vehicleId       String
  productId       String
  quantity        Int     @default(0)
  openingQuantity Int     @default(0)
  tenantId        String  @default("VK001")
  storeId         String?
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
  store           Store?  @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, productId])
  @@index([tenantId])
  @@index([storeId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  tenantId  String          @default("VK001")
  storeId   String?
  userId    String?
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  store     Store?          @relation(fields: [storeId], references: [id])
  user      User?           @relation("UserStockTransactions", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
  @@index([userId])
}

model Route {
  id               String              @id @default(cuid())
  routeName        String
  villages         String[]
  status           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenantId         String              @default("VK001")
  storeId          String?
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  store            Store?              @relation(fields: [storeId], references: [id])
  cycles           RouteCycle[]
  assignments      RouteAssignment[]
  orders           Order[]
  monthlySummaries VgeMonthlySummary[]

  @@unique([tenantId, storeId, routeName])
  @@index([tenantId])
  @@index([status])
  @@index([storeId])
}

model RouteCycle {
  id          String    @id @default(cuid())
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  tenantId    String    @default("VK001")
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
  @@index([tenantId])
}

model RouteAssignment {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime @default(now())
  status           Boolean  @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  tenantId         String   @default("VK001")
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  route            Route    @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([userId, status])
}

model Village {
  id         String            @id @default(cuid())
  name       String
  latitude   Float?
  longitude  Float?
  boundary   Json? // GeoJSON Polygon
  isPolygon  Boolean           @default(false)
  status     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenantId   String            @default("VK001")
  storeId    String?
  radius     Int               @default(500)
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  store      Store?            @relation(fields: [storeId], references: [id])
  activities VillageActivity[]

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model OpeningCash {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  date             String
  denominations    Json
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  tenantId         String   @default("VK001")
  shift            Int      @default(1)
  isNoService      Boolean  @default(false)
  storeId          String?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  store            Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model ClosingCash {
  id            String   @id @default(cuid())
  vehicleId     String
  userId        String
  date          String
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  tenantId      String   @default("VK001")
  shift         Int      @default(1)
  expenses      Float    @default(0)
  isNoService   Boolean  @default(false)
  storeId       String?
  cardSales     Float    @default(0)
  upiSales      Float    @default(0)
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model BusinessSettings {
  id           String   @id @default(cuid())
  businessName String   @default("VillagKart")
  gstNo        String?
  contactNo    String?
  email        String?
  address      String?
  taxRates     String   @default("0,5,12,18")
  shifts       Json? // Array of { id, name, startTime, endTime, isActive }
  shiftMode    String   @default("STANDARD")
  updatedAt    DateTime @updatedAt
  tenantId     String   @default("VK001")
  storeId      String?  @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model DailyCashSummary {
  id            String   @id @default(cuid())
  vehicleId     String
  date          String
  openingCash   Float    @default(0)
  cashSales     Float    @default(0)
  expectedCash  Float    @default(0)
  actualCash    Float    @default(0)
  difference    Float    @default(0)
  status        String   @default("PENDING")
  updatedAt     DateTime @updatedAt
  expenses      Float    @default(0)
  submittedCash Float    @default(0)
  userId        String?
  tenantId      String   @default("VK001")
  storeId       String?
  cardSales     Float    @default(0)
  upiSales      Float    @default(0)
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User?    @relation("UserDailyCashSummary", fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([storeId])
}

model StoreCashRegister {
  id                   String   @id @default(cuid())
  tenantId             String   @default("VK001")
  storeId              String
  date                 String
  openingCash          Float
  openingDenominations Json
  expectedClosingCash  Float?
  actualClosingCash    Float?
  closingDifference    Float?
  closingDenominations Json?
  status               String   @default("OPEN")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  closedById           String?
  openedById           String?
  closingRemarks       String?
  openedBy             User?    @relation("OpenedRegisters", fields: [openedById], references: [id])
  closedBy             User?    @relation("ClosedRegisters", fields: [closedById], references: [id])
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  store                Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
  @@index([tenantId])
  @@index([openedById])
  @@index([closedById])
}

model StoreDeposit {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  storeId       String
  date          String
  shift         Int
  amount        Float
  denominations Json
  description   String
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  store         Store    @relation(fields: [storeId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([storeId, date, shift])
  @@index([tenantId])
}

model Expense {
  id          String             @id @default(cuid())
  userId      String
  vehicleId   String?
  type        String
  amount      Float
  paymentMode ExpensePaymentMode
  description String?
  billImage   String?
  status      ExpenseStatus      @default(PENDING)
  date        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String             @default("VK001")
  storeId     String?
  displayId   String?            @unique
  user        User               @relation(fields: [userId], references: [id])
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])
  store       Store?             @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([storeId])
}

model CashTransfer {
  id            String   @id @default(cuid())
  userId        String
  vehicleId     String
  date          String
  amount        Float
  denominations Json?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String   @default("VK001")
  storeId       String?
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([userId])
  @@index([storeId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  limit     Float?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @default("VK001")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model DailyCoverage {
  id          String   @id @default(cuid())
  vehicleId   String
  routeId     String?
  date        String
  villageName String
  morningDone Boolean  @default(false)
  eveningDone Boolean  @default(false)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String   @default("VK001")
  storeId     String?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  store       Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])

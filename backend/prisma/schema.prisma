model Attendance {
  id               String           @id @default(cuid())
  userId           String
  tenantId         String           @default("VK001")
  storeId          String?
  date             String
  punchInTime      DateTime
  punchOutTime     DateTime?
  status           AttendanceStatus @default(ACTIVE)
  punchInLat       Float?
  punchInLng       Float?
  punchOutLat      Float?
  punchOutLng      Float?
  totalHours       Float?
  punchInPhoto     String?
  punchInLocation  String?
  punchOutPhoto    String?
  punchOutLocation String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store? @relation(fields: [storeId], references: [id])

  @@unique([userId, date])
  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model ShiftLog {
  id             String    @id @default(cuid())
  tenantId       String    @default("VK001")
  storeId        String?
  userId         String
  vehicleId      String?
  date           String // YYYY-MM-DD
  shift          Int       @default(1) // 1 = Morning, 2 = Afternoon
  startTime      DateTime  @default(now())
  endTime        DateTime?
  startLat       Float
  startLong      Float
  startFacePhoto String?
  endLat         Float?
  endLong        Float?
  status         String    @default("STARTED") // STARTED, COMPLETED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  store      Store?            @relation(fields: [storeId], references: [id])
  activities VillageActivity[]

  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model VillageActivity {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  userId      String
  shiftLogId  String
  villageId   String?
  villageName String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  startLat    Float
  startLong   Float
  endLat      Float?
  endLong     Float?
  subLocation String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shiftLog ShiftLog @relation(fields: [shiftLogId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  village  Village? @relation(fields: [villageId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([shiftLogId])
}

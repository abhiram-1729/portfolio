generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Tenant {
  id                       String                    @id @default(cuid())
  name                     String
  code                     String                    @unique
  contactEmail             String?
  contactPhone             String?
  address                  String?
  logo                     String?
  status                   TenantStatus              @default(ACTIVE)
  planName                 String                    @default("FREE")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    User[]
  categories               Category[]
  brands                   Brand[]
  products                 Product[]
  warehouses               Warehouse[]
  orders                   Order[]
  orderReturns             OrderReturn[]
  vehicles                 Vehicle[]
  routes                   Route[]
  villages                 Village[]
  expenseCategories        ExpenseCategory[]
  units                    Unit[]
  assets                   Asset[]
  businessSettings         BusinessSettings[]
  incentiveConfig          VgeIncentiveConfig[]
  orderItems               OrderItem[]
  payments                 Payment[]
  sessionSales             SessionSales[]
  assetCategories          AssetCategory[]
  stores                   Store[]
  stockAudits              StockAudit[]
  stockAuditItems          StockAuditItem[]
  refillItems              RefillItem[]
  dailyPerformance         VgeDailyPerformance[]
  monthlySummaries         VgeMonthlySummary[]
  assetRequests            AssetRequest[]
  customRoles              CustomRole[]
  activityLogs             ActivityLog[]             @relation("TenantActivityLogs")
  storeCashRegisters       StoreCashRegister[]
  storeDeposits            StoreDeposit[]
  vendors                  Vendor[]
  vendorItemMappings       VendorItemMapping[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptItems        GoodsReceiptItem[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceItems     PurchaseInvoiceItem[]
  safeTransactions         SafeTransaction[]
  procurementStockLedger   ProcurementStockLedger[]
  vendorLedger             VendorLedger[]
  vendorPayments           VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]
  attendances              Attendance[]
  damageEntries            DamageEntry[]
  damageDeductions         DamageDeduction[]
  shiftLogs                ShiftLog[]
  villageActivities        VillageActivity[]
  locationLogs             LocationLog[]
  idSequences              IdSequence[]
  lateConfigs              LateEntryConfig[]
  lateEntries              LateEntry[]
  lateExceptions           LateEntryException[]
  leaveBalances            LeaveBalance[]
  shifts                   Shift[]
  customers                Customer[]
  promotions               Promotion[]
  purchaseRequisitions     PurchaseRequisition[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  stockTransfers           StockTransfer[]
  stockTransferItems       StockTransferItem[]
  workOrders               WorkOrder[]
  workOrderItems           WorkOrderItem[]
  posTerminals             POSTerminal[]
  suspendedSales           SuspendedSale[]
  vendorPriceHistories     VendorPriceHistory[]
}

model User {
  id                   String                  @id @default(cuid())
  name                 String?
  email                String                  @unique
  password             String
  mobile               String?                 @unique
  role                 UserRole                @default(CONSUMER)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  assignedVehicleId    String?
  dailyTarget          Float?                  @default(10000)
  status               UserStatus              @default(ACTIVE)
  fcmToken             String?
  baseSalary           Float?                  @default(12000)
  tenantId             String                  @default("VK001")
  vgeType              String                  @default("EMPLOYEE")
  storeId              String?
  displayId            String?
  customRoleId         String?
  attendanceEnabled    Boolean                 @default(true)
  kycStatus            KYCStatus               @default(PENDING)
  shiftId              String?
  avatar               String?
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  assignedVehicle      Vehicle?                @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  store                Store?                  @relation(fields: [storeId], references: [id])
  customRole           CustomRole?             @relation(fields: [customRoleId], references: [id])
  orders               Order[]
  carts                Cart[]
  openingCash          OpeningCash[]
  closingCash          ClosingCash[]
  routeAssignments     RouteAssignment[]
  refillRequests       RefillRequest[]
  notifications        Notification[]
  stockTransactions    StockTransaction[]      @relation("UserStockTransactions")
  shiftLogs            ShiftLog[]
  attendances          Attendance[]
  dailyPerformance     VgeDailyPerformance[]   @relation("UserDailyPerformance")
  monthlySummaries     VgeMonthlySummary[]     @relation("UserMonthlySummary")
  assetAssignments     AssetAssignment[]
  assetIssues          AssetIssue[]
  expenses             Expense[]
  cashTransfers        CashTransfer[]
  storeDeposits        StoreDeposit[]
  dailySummaries       DailyCashSummary[]      @relation("UserDailyCashSummary")
  assetRequests        AssetRequest[]          @relation("UserAssetRequests")
  locationCheckIns     LocationCheckIn[]
  stockAudits          StockAudit[]
  bankDeposits         BankDeposit[]
  actions              ActivityLog[]           @relation("UserActions")
  targetActions        ActivityLog[]           @relation("TargetActions")
  damageReports        DamageEntry[]           @relation("DamageReporter")
  damageReviews        DamageEntry[]           @relation("DamageReviewer")
  vehicleDamageReports VehiclePhysicalDamage[] @relation("VehicleDamageReporter")
  deductionsReceived   DamageDeduction[]       @relation("DeductionTarget")
  deductionsApplied    DamageDeduction[]       @relation("DeductionApplier")
  safeTransactions     SafeTransaction[]
  openedRegisters      StoreCashRegister[]     @relation("OpenedRegisters")
  closedRegisters      StoreCashRegister[]     @relation("ClosedRegisters")
  villageActivities    VillageActivity[]
  locationLogs         LocationLog[]
  approvedRefills      RefillRequest[]         @relation("ApprovedRefills")
  lateEntries          LateEntry[]
  lateExceptions       LateEntryException[]    @relation("UserExceptions")
  approvedExceptions   LateEntryException[]    @relation("ApprovedBy")
  leaveBalances        LeaveBalance[]
  createdStores        Store[]                 @relation("StoreCreator")
  vehicleTrips         VehicleTrip[]
  documents            UserDocument[]
  shift                Shift?                  @relation(fields: [shiftId], references: [id])
  suspendedSales       SuspendedSale[]

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([assignedVehicleId])
  @@index([role])
  @@index([status])
  @@index([customRoleId])
}

model UserDocument {
  id             String         @id @default(cuid())
  userId         String
  type           DocumentType
  documentNumber String?
  fileUrl        String
  status         DocumentStatus @default(PENDING)
  remarks        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  portalType  String   @default("ADMIN")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  tenantId      String        @default("VK001")
  storeId       String?
  subCategories SubCategory[]
  products      Product[]
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  store         Store?        @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  tenantId   String    @default("VK001")
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@index([tenantId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  tenantId String    @default("VK001")
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                 String                    @id @default(cuid())
  name               String
  description        String?
  price              Float
  image              String?
  categoryId         String
  subCategoryId      String
  brandId            String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  mrp                Float?
  status             ItemStatus                @default(ACTIVE)
  discount           Float?
  landingPrice       Float?
  gst                Float?                    @default(0)
  isFree             Boolean                   @default(false)
  minShopAmount      Float                     @default(0)
  unitId             String?
  unitValue          Float?
  tenantId           String                    @default("VK001")
  storeId            String?
  barcode            String?
  minStockAlert      Int?                      @default(0)
  purchasePrice      Float?                    @default(0)
  skuCode            String?
  displayId          String?
  stock              Int                       @default(0)
  isRawStock         Boolean                   @default(false)
  rawStockRatio      Float?                    @default(1)
  comboItems         Json?
  isCombo            Boolean                   @default(false)
  store              Store?                    @relation(fields: [storeId], references: [id])
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  category           Category                  @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory               @relation(fields: [subCategoryId], references: [id])
  brand              Brand                     @relation(fields: [brandId], references: [id])
  unit               Unit?                     @relation(fields: [unitId], references: [id])
  variants           ProductVariant[]
  WarehouseInventory WarehouseInventory[]
  vehicleStocks      VehicleStock[]
  stockTransactions  StockTransaction[]
  orderItems         OrderItem[]
  refillItems        RefillItem[]
  auditItems         StockAuditItem[]
  vendorMappings     VendorItemMapping[]
  poItems            PurchaseOrderItem[]
  grnItems           GoodsReceiptItem[]
  purchaseItems      PurchaseInvoiceItem[]
  damageEntries      DamageEntry[]
  procurementLedger  ProcurementStockLedger[]
  orderReturns       OrderReturn[]
  requisitionItems   PurchaseRequisitionItem[]
  transferItems      StockTransferItem[]
  workOrderItems     WorkOrderItem[]

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([storeId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  price     Float
  productId String
  tenantId  String  @default("VK001")
  product   Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
}

model Warehouse {
  id        String               @id @default(cuid())
  name      String
  location  String?
  tenantId  String               @default("VK001")
  inventory WarehouseInventory[]
  tenant    Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  tenantId    String    @default("VK001")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenantId  String     @default("VK001")
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  tenantId  String @default("VK001")
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@index([tenantId])
}

model Order {
  id                 String        @id @default(cuid())
  userId             String?
  agentId            String?
  totalAmount        Float
  status             OrderStatus   @default(PENDING)
  paymentMode        PaymentMode?
  mobile             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  vehicleId          String?
  orderNumber        Int           @unique @default(autoincrement())
  customerName       String?
  coverageType       CoverageType?
  routeId            String?
  villageName        String?
  tenantId           String        @default("VK001")
  storeId            String?
  displayId          String?
  cashAmount         Float?        @default(0)
  upiAmount          Float?        @default(0)
  customerId         String?
  deliveryCharge     Float         @default(0)
  deliverySlot       String?
  deliveryDate       DateTime?
  appliedPromotionId String?
  discountAmount     Float         @default(0)
  salesChannel       SalesChannel  @default(POS)
  appliedPromotion   Promotion?    @relation(fields: [appliedPromotionId], references: [id])
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  user               User?         @relation(fields: [userId], references: [id])
  vehicle            Vehicle?      @relation(fields: [vehicleId], references: [id])
  route              Route?        @relation(fields: [routeId], references: [id])
  store              Store?        @relation(fields: [storeId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  items              OrderItem[]
  returns            OrderReturn[]
  payment            Payment?
  terminalId         String?
  terminal           POSTerminal?  @relation(fields: [terminalId], references: [id])

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([userId])
  @@index([agentId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([routeId])
  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Float
  discount     Float?
  mrp          Float?
  landingPrice Float?
  gst          Float?     @default(0)
  tenantId     String     @default("VK001")
  storeId      String?
  promotionId  String?
  order        Order      @relation(fields: [orderId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  store        Store?     @relation(fields: [storeId], references: [id])
  promotion    Promotion? @relation(fields: [promotionId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  paymentMode PaymentMode
  amount      Float
  status      String
  createdAt   DateTime    @default(now())
  tenantId    String      @default("VK001")
  storeId     String?
  cashAmount  Float?      @default(0)
  upiAmount   Float?      @default(0)
  order       Order       @relation(fields: [orderId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  store       Store?      @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
}

model Vehicle {
  id                String                  @id @default(cuid())
  vehicleNumber     String
  status            Boolean                 @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  tenantId          String                  @default("VK001")
  storeId           String?
  displayId         String?
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  store             Store?                  @relation(fields: [storeId], references: [id])
  assignedUsers     User[]                  @relation("UserVehicle")
  stocks            VehicleStock[]
  transactions      StockTransaction[]
  orders            Order[]
  openingCash       OpeningCash[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  routeAssignments  RouteAssignment[]
  dailyCoverages    DailyCoverage[]
  refillRequests    RefillRequest[]
  expenses          Expense[]
  cashTransfers     CashTransfer[]
  stockAudits       StockAudit[]
  damageEntries     DamageEntry[]
  trips             VehicleTrip[]
  fuelLogs          FuelLog[]
  maintenanceLogs   MaintenanceLog[]
  physicalDamages   VehiclePhysicalDamage[]
  assetUnits        AssetUnit[]
  assetAssignments  AssetAssignment[]

  @@unique([tenantId, vehicleNumber])
  @@unique([tenantId, displayId])
  @@index([tenantId])
}

model VehiclePhysicalDamage {
  id              String                @id @default(cuid())
  tenantId        String                @default("VK001")
  storeId         String?
  vehicleId       String
  reportedById    String
  damageType      String
  severity        VehicleDamageSeverity @default(MINOR)
  title           String
  description     String?
  location        String?
  images          String[]
  estimatedCost   Float?                @default(0)
  actualCost      Float?
  status          VehicleDamageStatus   @default(REPORTED)
  repairDate      DateTime?
  repairNotes     String?
  odometerReading Float?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id])
  reportedBy      User                  @relation("VehicleDamageReporter", fields: [reportedById], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
}

model VehicleStock {
  id              String  @id @default(cuid())
  vehicleId       String
  productId       String
  quantity        Int     @default(0)
  openingQuantity Int     @default(0)
  tenantId        String  @default("VK001")
  storeId         String?
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
  store           Store?  @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, productId])
  @@index([tenantId])
  @@index([storeId])
}

model VehicleTrip {
  id              String           @id @default(cuid())
  vehicleId       String
  userId          String
  date            String
  shift           Int              @default(1)
  status          TripStatus       @default(OPEN)
  startOdometer   Float?
  endOdometer     Float?
  openingCash     Float?           @default(0)
  closingCash     Float?           @default(0)
  totalSales      Float?           @default(0)
  totalExpenses   Float?           @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenantId        String           @default("VK001")
  storeId         String?
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model FuelLog {
  id          String             @id @default(cuid())
  vehicleId   String
  tripId      String?
  date        String
  odometer    Float
  liters      Float
  rate        Float
  totalAmount Float
  paymentMode ExpensePaymentMode
  billImage   String?
  createdAt   DateTime           @default(now())
  tenantId    String             @default("VK001")
  storeId     String?
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id])
  trip        VehicleTrip?       @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([tripId])
}

model MaintenanceLog {
  id           String       @id @default(cuid())
  vehicleId    String
  tripId       String?
  date         String
  odometer     Float
  serviceType  String
  details      String?
  amount       Float
  mechanicName String?
  billImage    String?
  createdAt    DateTime     @default(now())
  tenantId     String       @default("VK001")
  storeId      String?
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  trip         VehicleTrip? @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([tripId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  tenantId  String          @default("VK001")
  storeId   String?
  userId    String?
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  store     Store?          @relation(fields: [storeId], references: [id])
  user      User?           @relation("UserStockTransactions", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
  @@index([userId])
}

model Route {
  id               String              @id @default(cuid())
  routeName        String
  villages         String[]
  status           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenantId         String              @default("VK001")
  storeId          String?
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  store            Store?              @relation(fields: [storeId], references: [id])
  cycles           RouteCycle[]
  assignments      RouteAssignment[]
  orders           Order[]
  monthlySummaries VgeMonthlySummary[]

  @@unique([tenantId, storeId, routeName])
  @@index([tenantId])
  @@index([status])
  @@index([storeId])
}

model RouteCycle {
  id          String    @id @default(cuid())
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  tenantId    String    @default("VK001")
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
  @@index([tenantId])
}

model RouteAssignment {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime @default(now())
  status           Boolean  @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  tenantId         String   @default("VK001")
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  route            Route    @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([userId, status])
}

model Village {
  id         String            @id @default(cuid())
  name       String
  status     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenantId   String            @default("VK001")
  latitude   Float?
  longitude  Float?
  storeId    String?
  radius     Int               @default(500)
  boundary   Json?
  isPolygon  Boolean           @default(false)
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  store      Store?            @relation(fields: [storeId], references: [id])
  activities VillageActivity[]
  customers  Customer[]

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model OpeningCash {
  id               String   @id @default(cuid())
  vehicleId        String
  userId           String
  date             String
  denominations    Json
  totalOpeningCash Float
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  tenantId         String   @default("VK001")
  shift            Int      @default(1)
  isNoService      Boolean  @default(false)
  storeId          String?
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  store            Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model ClosingCash {
  id            String   @id @default(cuid())
  vehicleId     String
  userId        String
  date          String
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  tenantId      String   @default("VK001")
  shift         Int      @default(1)
  expenses      Float    @default(0)
  isNoService   Boolean  @default(false)
  storeId       String?
  cardSales     Float    @default(0)
  upiSales      Float    @default(0)
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model BusinessSettings {
  id                     String   @id @default(cuid())
  businessName           String   @default("VillagKart")
  gstNo                  String?
  contactNo              String?
  email                  String?
  address                String?

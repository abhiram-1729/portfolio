model LocationLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  userId      String
  lat         Float
  long        Float
  accuracy    Float?
  subLocation String?
  timestamp   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
}

